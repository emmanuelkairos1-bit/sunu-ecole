# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...   # clé "service_role" : SECRÈTE, jamais dans le navigateur

# --- Chiffrement AES-256-GCM : 64 caractères hexadécimaux ---
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Clé pour recherche par email (HMAC), même méthode de génération
HASH_PEPPER=

# --- Email (Gmail : activer la validation en 2 étapes puis créer un "mot de passe d'application") ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ecolesunu@gmail.com
SMTP_PASS=
MAIL_TO=ecolesunu@gmail.com

# --- Captcha Cloudflare Turnstile (gratuit : dash.cloudflare.com > Turnstile > Add site) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# --- App ---
APP_URL=https://sunu-ecole.onrender.com
NODE_ENV=production
PORT=3000
